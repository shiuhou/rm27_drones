# Historical reference workspaces are kept outside this repository.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
/research/astra/build/
/research/astra/results/*
!/research/astra/results/.gitkeep
# Raw CAD is kept locally and indexed by hash in the relevant report.
/data/references/cad_raw/*.stp
/data/references/cad_raw/*.step
/data/references/cad_raw/*.SLDASM
/.vscode/
/artifacts/
# MuJoCo local window/GLFW diagnostic output.
/MUJOCO_LOG.TXT
/data/flight_logs/data/
/RoboMaster*.pdf
/UTF-8__RoboMaster*.pdf
/data/references/rules/*.pdf
/data/references/images/*
/docs/archive/chatgptre.md
/data/references/cad_raw/*.STEP
/data/references/cad_raw/*.STP
/data/references/cad_raw/retired/
# Local engineering plans and run records; only .agents/docs/ is tracked.
/.agents/plans/
/.agents/runs/
