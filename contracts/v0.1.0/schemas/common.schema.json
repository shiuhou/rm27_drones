{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rm27.example/contracts/v0.1.0/common.schema.json",
  "title": "RM27 shared definitions",
  "x-rm27": {
    "version": "0.1.0-draft",
    "status": "PROPOSED",
    "document": ".agents/docs/contracts/README.md"
  },
  "$ref": "#/$defs/RecordMetadata",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "Identity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false,
      "description": "Content identity; a valid digest does not prove the referenced bytes or consumer compatibility."
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "QuaternionWxyz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Unit Hamilton quaternion [w,x,y,z]; q_AB rotates from B to A. Norm requires a declared numerical tolerance outside JSON Schema."
    },
    "Matrix3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Vec3"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "BLOCKED"
      ]
    },
    "SourceKind": {
      "enum": [
        "GROUND_TRUTH",
        "SYNTHETIC",
        "RECORDED",
        "REAL_MEASURED",
        "ESTIMATED",
        "PREDICTED"
      ]
    },
    "FrameConvention": {
      "type": "object",
      "properties": {
        "world": {
          "const": "NED"
        },
        "body": {
          "const": "FRD"
        },
        "quaternion": {
          "const": "HAMILTON_WXYZ"
        }
      },
      "required": [
        "world",
        "body",
        "quaternion"
      ],
      "additionalProperties": false
    },
    "TimeInterval": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number"
        },
        "end_s": {
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "additionalProperties": false,
      "description": "Physical interval in seconds within the enclosing declared clock. Clock alignment and interval ordering are checked separately."
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "missing_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeInterval"
          }
        },
        "reason": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "missing_intervals": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "VerdictEvidence": {
      "type": "object",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "reason": {
          "$ref": "#/$defs/Id"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false
    },
    "Availability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNKNOWN",
            "INVALID",
            "UNSUPPORTED"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        }
      ]
    },
    "Lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input_kind": {
            "$ref": "#/$defs/SourceKind"
          },
          "source": {
            "$ref": "#/$defs/Id"
          },
          "record_id": {
            "$ref": "#/$defs/Id"
          },
          "transform": {
            "$ref": "#/$defs/Id"
          }
        },
        "required": [
          "input_kind",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "#/$defs/Id"
          },
          "data": {}
        },
        "required": [
          "version",
          "data"
        ],
        "additionalProperties": false
      },
      "description": "Named, versioned extension payloads; cannot override base fields or gate acceptance without separate consumer support."
    },
    "RecordMetadata": {
      "type": "object",
      "properties": {
        "contract_id": {
          "enum": [
            "rm27.state",
            "rm27.dynamics",
            "rm27.geometry",
            "rm27.control",
            "rm27.evaluation",
            "rm27.feasibility"
          ]
        },
        "contract_version": {
          "const": "0.1.0-draft"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "record_id": {
          "$ref": "#/$defs/Id"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "input_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "lineage": {
          "$ref": "#/$defs/Lineage"
        },
        "clock_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reset_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/Availability"
          }
        },
        "model": {
          "$ref": "#/$defs/Identity"
        },
        "geometry": {
          "$ref": "#/$defs/Identity"
        },
        "config_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "record_id",
        "source",
        "sequence",
        "input_kind",
        "lineage",
        "clock_id",
        "frame_id",
        "reset_epoch",
        "availability"
      ],
      "additionalProperties": false,
      "description": "Record envelope. Null clock/frame/reset is explicit unavailability, not admission for physical use. Lineage retains ancestry through derivation and replay."
    }
  }
}
